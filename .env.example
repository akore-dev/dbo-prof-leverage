# AI interpretation
OPENAI_API_KEY=
OPENAI_MODEL=

# Public URL used in referral links
SITE_URL=http://localhost:3000

# PostgreSQL (DATABASE_URL is preferred)
DATABASE_URL=
PGSSLMODE=require

# Referral signing and unlock goal
REFERRER_CODE_SECRET=replace-with-a-long-random-secret
REFERRAL_GOAL=3

# Admin access (ADMIN_SESSION_SECRET must be at least 32 characters)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Local production server
HOST=0.0.0.0
PORT=8080